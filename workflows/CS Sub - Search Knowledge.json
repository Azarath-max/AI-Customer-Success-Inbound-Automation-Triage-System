        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT doc_id, title, category, content,\n       ROUND((1 - (embedding <=> '{{ JSON.stringify($json.embedding.values) }}'::vector))::numeric, 3) AS similarity\nFROM knowledge_documents\nWHERE embedding IS NOT NULL\nORDER BY embedding <=> '{{ JSON.stringify($json.embedding.values) }}'::vector\nLIMIT 3;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
