      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "8NJ3OPTtToR2QoOq",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const MIN_SIMILARITY = 0.55; // tune after testing\n\nconst rows = $input.all().map(i => i.json).filter(r => r.doc_id);\nconst docs = rows\n  .filter(r => Number(r.similarity) >= MIN_SIMILARITY)\n  .map(r => ({\n    doc_id: r.doc_id,\n    title: r.title,\n    category: r.category,\n    content: r.content,\n    similarity: Number(r.similarity)\n  }));\n\nreturn [{ json: { rag_status: docs.length ? 'ok' : 'no_match', docs } }];"
      },
